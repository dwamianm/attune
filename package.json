{
  "name": "attune-workspace",
  "private": true,
  "type": "module",
  "description": "Attune: an AI-native adaptive UI library (packages/) and the prototype app that drives it (apps/demo).",
  "scripts": {
    "dev": "pnpm --filter @attune/demo dev",
    "dev:playground": "pnpm --filter @attune/playground dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "eval": "pnpm --filter @attune/demo eval",
    "deploy:aws": "pnpm --filter @attune/demo deploy:aws"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
